# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env`, and never paste the token into a chat window.

# Which auth path you set up in the Meta developer portal:
#   instagram = "Manage messaging and content on Instagram" use case.
#               Direct Instagram login, no Facebook Page needed. ← what we use
#   facebook  = the older Page-linked Graph API.
AUTH_MODE=instagram

# Your Instagram account ID (a long number, NOT your @handle).
# `node check.js` will print it for you once the token is set.
IG_USER_ID=

# Long-lived access token from the Meta developer portal (~60 day expiry).
IG_ACCESS_TOKEN=

# Graph API version. Meta retires versions after roughly two years — if a call
# starts failing with a deprecation error, bump this to the current version
# listed at developers.facebook.com/docs/graph-api/changelog
GRAPH_VERSION=v23.0
